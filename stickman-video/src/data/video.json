    {
      "type": "quote",
      "variant": "ornate",
      "title": "سُورَةُ النِّسَاء",
      "start": 89.77,
      "end": 101.59,
      "segments": [
        {"text": "وَإِذَا قَامُوا إِلَى الصَّلَاةِ قَامُوا كُسَالَىٰ", "highlight": true},
        {"text": " يُرَاءُونَ النَّاسَ وَلَا يَذْكُرُونَ اللَّهَ إِلَّا قَلِيلًا"}
      ]
    },
