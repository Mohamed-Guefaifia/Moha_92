{
  "lang": "ar",
  "title": "النفاق وصفات المنافقين",
  "scenes": [
    {"id": "scene-01", "clauses": [
      "من هو المنافق؟",
      "إنسان بوجهين:",
      "يظهر لك الإيمان",
      "ويخفي في قلبه غيره"
    ]},
    {"id": "scene-02", "clauses": [
      "قال الله تعالى:",
      "ومن الناس من يقول",
      "آمنا بالله وباليوم الآخر",
      "وما هم بمؤمنين"
    ]},
    {"id": "scene-03", "clauses": [
      "يقف أمامك بكل أدب",
      "وكلامه معسول"
    ]},
    {"id": "scene-04", "clauses": [
      "لكنه يخفي في داخله",
      "غير ما يظهر لك"
    ]},
    {"id": "scene-05", "clauses": [
      "العلامة الأولى:",
      "إذا حدث كذب",
      "وإذا خاصم فجر"
    ]},
    {"id": "scene-06", "clauses": [
      "والعلامة الثانية:",
      "إذا وعد أخلف.",
      "يعدك اليوم",
      "ويتركك غدا"
    ]},
    {"id": "scene-07", "clauses": [
      "والعلامة الثالثة:",
      "إذا اؤتمن خان.",
      "أمانته مظهر",
      "وقلبه غادر"
    ]},
    {"id": "scene-08", "clauses": [
      "قال النبي صلى الله عليه وسلم:",
      "آية المنافق ثلاث:",
      "إذا حدث كذب",
      "وإذا وعد أخلف",
      "وإذا اؤتمن خان"
    ]},
    {"id": "scene-09", "clauses": [
      "ومن صفاتهم الكسل في الصلاة",
      "يؤجلها ويتثاقل عنها",
      "حتى يخرج وقتها"
    ]},
    {"id": "scene-10", "clauses": [
      "فإذا صلى أمام الناس",
      "تجمل وأحسن",
      "رياء لا إخلاصا"
    ]},
    {"id": "scene-11", "clauses": [
      "قال الله تعالى:",
      "وإذا قاموا إلى الصلاة قاموا كسالى",
      "يراؤون الناس",
      "ولا يذكرون الله إلا قليلا"
    ]},
    {"id": "scene-12", "clauses": [
      "يحب المدح والظهور",
      "يعمل ليراه الناس",
      "لا ليرضي الله"
    ]},
    {"id": "scene-13", "clauses": [
      "ويسخر من المؤمنين",
      "ويستهزئ بهم في غيابهم"
    ]},
    {"id": "scene-14", "clauses": [
      "يمشي بالنميمة بين الناس",
      "يشعل الفتنة",
      "ثم يقف كأنه بريء"
    ]},
    {"id": "scene-15", "clauses": [
      "ذو وجهين:",
      "يأتي هؤلاء بوجه",
      "وهؤلاء بوجه آخر"
    ]},
    {"id": "scene-16", "clauses": [
      "قال النبي صلى الله عليه وسلم:",
      "تجدون شر الناس ذا الوجهين",
      "الذي يأتي هؤلاء بوجه",
      "وهؤلاء بوجه"
    ]},
    {"id": "scene-17", "clauses": [
      "إذا رأى النعمة على غيره",
      "حسد وتمنى زوالها"
    ]},
    {"id": "scene-18", "clauses": [
      "وعند الشدة يفر",
      "لا ثبات له ولا صدق"
    ]},
    {"id": "scene-19", "clauses": [
      "فيا من رأى في نفسه",
      "شيئا من هذه الصفات",
      "بادر بالتوبة",
      "قبل فوات الأوان"
    ]},
    {"id": "scene-20", "clauses": [
      "وحاسب نفسك كل يوم:",
      "هل تصدق في كلامك؟",
      "هل توفي بوعدك؟",
      "هل تعمل لله وحده؟"
    ]},
    {"id": "scene-21", "clauses": [
      "الصدق نجاة",
      "والإخلاص نور.",
      "اللهم طهر قلوبنا من النفاق",
      "وأعمالنا من الرياء.",
      "شارك الفيديو لتذكر غيرك"
    ]}
  ]
}
