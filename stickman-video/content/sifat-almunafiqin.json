{
  "lang": "ar",
  "title": "صفات المنافقين",
  "scenes": [
    {"id": "scene-01", "clauses": [
      "هل يمكن أن تكون في قلوبنا صفات من النفاق",
      "ونحن لا نشعر؟",
      "النبي صلى الله عليه وسلم حذرنا من ثلاث علامات"
    ]},
    {"id": "scene-02", "clauses": [
      "العلامة الأولى:",
      "إذا حدث كذب.",
      "كلامه جميل",
      "لكن الحقيقة شيء آخر"
    ]},
    {"id": "scene-03", "clauses": [
      "العلامة الثانية:",
      "إذا وعد أخلف.",
      "يعدك اليوم",
      "وينساك غدا"
    ]},
    {"id": "scene-04", "clauses": [
      "والعلامة الثالثة:",
      "إذا اؤتمن خان.",
      "تأمنه على سرك أو مالك",
      "فيضيعه"
    ]},
    {"id": "scene-05", "clauses": [
      "قال النبي صلى الله عليه وسلم:",
      "آية المنافق ثلاث:",
      "إذا حدث كذب",
      "وإذا وعد أخلف",
      "وإذا اؤتمن خان"
    ]},
    {"id": "scene-06", "clauses": [
      "ومن صفاتهم أيضا:",
      "الكسل في الصلاة",
      "والرياء أمام الناس"
    ]},
    {"id": "scene-07", "clauses": [
      "قال الله تعالى:",
      "وإذا قاموا إلى الصلاة قاموا كسالى",
      "يراؤون الناس",
      "ولا يذكرون الله إلا قليلا"
    ]},
    {"id": "scene-08", "clauses": [
      "فحاسب نفسك اليوم:",
      "هل تصدق في كلامك؟",
      "هل توفي بوعدك؟",
      "هل تؤدي الأمانة؟"
    ]},
    {"id": "scene-09", "clauses": [
      "اصدق،",
      "وأوف بوعدك،",
      "وأد الأمانة",
      "تسلم من النفاق بإذن الله"
    ]},
    {"id": "scene-10", "clauses": [
      "اللهم طهر قلوبنا من النفاق",
      "وأعمالنا من الرياء.",
      "شارك الفيديو لتذكر غيرك"
    ]}
  ]
}
